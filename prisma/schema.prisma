// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Manager / Admin
model User {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String   @unique
  password String
  role     RoleType @default(manager)
}

enum RoleType {
  manager
}

// Staff with Fingerprint Support
model Staff {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  name        String
  email       String   @unique
  password    String?

  role        RoleTypes @default(worker)

  // WebAuthn Fields
  credentialId String?   @unique   // ← Important: Make it unique
  publicKey    String?

  // Login Session
  setupToken   String?
  tokenExpiry  DateTime?

  isActive     Boolean?  @default(true)

  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
}

enum RoleTypes {
  worker
}